# Gemini API 키 (필수)
GEMINI_API_KEY=your_gemini_api_key_here

# AWS S3 설정 (save="s3" 또는 "both" 사용 시 필요)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION_NAME=ap-northeast-2
S3_BUCKET_NAME=your-bucket-name

# 로컬 개발 시 백엔드 베이스 URL (기본값: http://localhost:8000)
BASE_URL=http://localhost:8000

# 사용할 Gemini LLM 모델 (텍스트 생성용)
DOCENT_MODEL=gemini-2.0-flash

# 전시 지식 검색에 쓰는 임베딩 모델 (기본값: gemini-embedding-001)
# 키가 없거나 호출이 실패하면 글자 기반 검색으로 대신합니다.
EMBEDDING_MODEL=gemini-embedding-001

# 참고:
# - /generate-text 와 Gemini TTS 경로는 GEMINI_API_KEY가 필요합니다.
# - 오픈소스 preset TTS(MeloTTS)와 OpenVoice clone 경로는 로컬 환경 의존성만 있으면 동작합니다.
